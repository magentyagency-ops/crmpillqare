# ════════════════════════════════════════════════════════════════════
#  CRM PillQare — configuration
#  Copiez ce fichier en `.env` (ou lancez `npm run setup`) puis complétez.
# ════════════════════════════════════════════════════════════════════

# ── Indispensable ───────────────────────────────────────────────────
# Base PostgreSQL (16+). En local, laissez la valeur ci-dessous : une base embarquée est démarrée par `npm run dev`.
# Supabase : pooler « transaction » (port 6543) ici, pooler « session » (port 5432) dans DIRECT_URL (migrations).
DATABASE_URL="postgresql://pillqare:pillqare@localhost:5433/pillqare_crm"
DIRECT_URL=""
# Base embarquée pour le développement (aucune installation). Mettre false en production.
EMBEDDED_POSTGRES=true

# Adresse publique du CRM (liens des emails : prise de RDV, devis en ligne, désinscription, formulaires).
# En production : https://crm.votre-domaine.fr
APP_URL="http://localhost:3000"

# Clé de chiffrement des secrets stockés (jetons Google, mots de passe IMAP/SMTP, Shopify).
# 64 caractères hexadécimaux — générée par `npm run setup`. Ne la changez plus une fois en production.
ENCRYPTION_KEY=""

# Fuseau horaire de l'entreprise (planning, relances, plages d'envoi)
APP_TIMEZONE="Europe/Paris"

# ── Emails ──────────────────────────────────────────────────────────
# live : envoi réel ; log : enregistrés dans le CRM sans être envoyés (défaut en développement)
EMAIL_DELIVERY=log
# En mode log : envoi réel quand même vers ces adresses ou domaines (tests), ex. "moi@gmail.com,@mon-domaine.fr"
EMAIL_TEST_ALLOWLIST=""
# Les commerciaux connectent leur boîte (Gmail ou IMAP/SMTP) dans Paramètres → Intégrations.
# Serveur SMTP « système » facultatif : invitations, mots de passe oubliés, planning quotidien
# quand l'utilisateur n'a pas encore connecté sa boîte.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="PillQare CRM <crm@votre-domaine.fr>"

# ── Google (Gmail, Agenda, Meet) ─────────────────────────────────────
# Console Google Cloud → API et services → Identifiants → ID client OAuth (application Web).
# URI de redirection autorisée : {APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Récupération automatique des transcriptions Google Meet (Google Workspace) : true/false
GOOGLE_MEET_TRANSCRIPTS=true

# ── Shopify ─────────────────────────────────────────────────────────
# Facultatif : la connexion se configure aussi depuis Paramètres → Intégrations.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_API_VERSION="2026-10"

# ── Intelligence artificielle ───────────────────────────────────────
# OpenAI (prioritaire si renseigné) : rédaction et personnalisation des emails, analyse des dossiers,
# comptes rendus de RDV et transcription audio.
# OPENAI_API_KEY est défini plus bas (section transcription).
OPENAI_MODEL="gpt-5.4-mini"
OPENAI_SMART_MODEL="gpt-5.5"
# Ou Claude (Anthropic) :
# Clé API Anthropic (console.anthropic.com). Sans clé : transcription seule, compte rendu manuel.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Effort de réflexion : low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# Transcription des enregistrements (un seul suffit ; détection automatique selon la clé fournie).
# Sans clé : reconnaissance vocale du navigateur (Chrome/Edge), voix du commercial uniquement.
TRANSCRIPTION_PROVIDER=""
ELEVENLABS_API_KEY=""
ELEVENLABS_STT_MODEL="scribe_v2"
OPENAI_API_KEY=""
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-transcribe"
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL="nova-3"

# ── Tâches de fond (relances, rappels, synchronisations) ────────────
# internal : exécutées par le serveur web (une seule instance suffit, verrou en base)
# external : exécutées par `npm run worker` ou par un appel périodique de /api/cron/tick
SCHEDULER_MODE=internal
# Secret pour /api/cron/tick (en-tête Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# ── Premier démarrage (facultatif) ──────────────────────────────────
# Sinon, l'administrateur est créé sur la page /installation au premier lancement.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_FIRSTNAME=""
SEED_ADMIN_LASTNAME=""
# Données de démonstration (3 commerciaux, 12 dossiers) : true pour une démo, jamais en production
SEED_DEMO=false
